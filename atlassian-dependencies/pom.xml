<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- no parent: the root imports this BOM -->
    <groupId>io.github.a-n-o-d-e-r</groupId>
    <artifactId>atlassian-dependencies</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>Atlassian Spring Boot Starter Dependencies</name>
    <description>Bill of materials of the Atlassian Spring Boot starters</description>
    <url>https://github.com/A-N-O-D-E-R/atlassian-springboot-starter</url>

    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://opensource.org/licenses/MIT</url>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>A-N-O-D-E-R</id>
            <name>A-N-O-D-E-R</name>
            <url>https://github.com/A-N-O-D-E-R</url>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:git://github.com/A-N-O-D-E-R/atlassian-springboot-starter.git</connection>
        <developerConnection>scm:git:ssh://github.com/A-N-O-D-E-R/atlassian-springboot-starter.git</developerConnection>
        <url>https://github.com/A-N-O-D-E-R/atlassian-springboot-starter</url>
        <tag>HEAD</tag>
    </scm>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>io.github.a-n-o-d-e-r</groupId>
                <artifactId>atlassian-jira</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.a-n-o-d-e-r</groupId>
                <artifactId>atlassian-confluence</artifactId>
                <version>${project.version}</version>
            </dependency>
