    <artifactId>atlassian-autoconfigure</artifactId>
    <name>Atlassian Auto-configuration</name>
    <description>Auto-configuration of the Atlassian clients from anode.atlassian.*</description>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.a-n-o-d-e-r</groupId>
            <artifactId>atlassian-jira</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>io.github.a-n-o-d-e-r</groupId>
            <artifactId>atlassian-confluence</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>tools.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
